PORT=3001
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tiktok-chot-don
SHOP_NAME=SHOP CỦA BẠN
PRINTER_NAME=POS-80
PRINTER_WIDTH=80

# ── Đăng nhập ──
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Domain frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173
# false khi chạy thử bằng http trên máy/mạng LAN; true khi chạy qua https
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Số proxy đứng trước backend (Cloudflare Tunnel = 1, Vercel + Tunnel = 2). Bỏ trống nếu chạy trực tiếp
TRUST_PROXY=
