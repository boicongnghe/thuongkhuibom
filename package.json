{
  "name": "tiktok-chot-don",
  "version": "1.0.1",
  "description": "Phần mềm chốt đơn realtime cho người bán hàng livestream TikTok",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend-react && npm run dev",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"nodemon backend/server.js\" \"cd frontend-react && npm run dev\"",
    "build": "cd frontend-react && npm install && npm run build",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "backend/src/**/*.js",
      "!backend/src/raw_print.ps1"
    ]
  },
  "keywords": [
    "tiktok",
    "live",
    "chot-don",
    "thermal-printer"
  ],
  "author": "Chot Don Live",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.1",
    "tiktok-live-connector": "^2.1.1-beta1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "build": {
    "appId": "vn.chotdon.live",
    "productName": "Chot Don Live",
    "copyright": "Chốt Đơn Live",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "!desktop/make-icon.js",
      "backend/src/tiktok.js",
      "backend/src/printer.js",
      "backend/src/raw_print.ps1"
    ],
    "asarUnpack": [
      "backend/src/raw_print.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "ChotDonLive-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chốt Đơn Live",
      "uninstallDisplayName": "Chốt Đơn Live",
      "deleteAppDataOnUninstall": false
    }
  }
}
